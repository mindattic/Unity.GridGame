<Window x:Class="ThumbnailStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ThumbnailStudio"
        Title="Thumbnail Studio" Icon="ThumbnailStudio.ico" Width="1480" Height="900" MinWidth="1100" MinHeight="680"
        Background="{StaticResource Bg}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Vis"/>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="290"/>
    </Grid.ColumnDefinitions>

    <!-- Unit list -->
    <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="0,0,1,0">
      <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="Thumbnail Studio" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock x:Name="FileText" Style="{StaticResource Caption}" Margin="0,2,0,12" TextTrimming="CharacterEllipsis"/>
          <Border Background="#111218" CornerRadius="5" Padding="3" Margin="0,0,0,8">
            <UniformGrid Columns="3">
              <RadioButton x:Name="FilterHeroes" Content="Heroes" Style="{StaticResource Segment}" GroupName="f" Checked="Filter_Changed"/>
              <RadioButton x:Name="FilterEnemies" Content="Enemies" Style="{StaticResource Segment}" GroupName="f" Checked="Filter_Changed"/>
              <RadioButton x:Name="FilterAll" Content="All" Style="{StaticResource Segment}" GroupName="f" IsChecked="True" Checked="Filter_Changed"/>
            </UniformGrid>
          </Border>
          <Grid Margin="0,0,0,10">
            <TextBox x:Name="SearchBox" TextChanged="Search_Changed"/>
            <TextBlock Text="Search name or id" Foreground="{StaticResource Muted}" Margin="9,0,0,0" VerticalAlignment="Center"
                       IsHitTestVisible="False" x:Name="SearchHint"/>
          </Grid>
        </StackPanel>
        <TextBlock x:Name="CountText" DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
        <ListBox x:Name="UnitList" Background="Transparent" BorderThickness="0" Focusable="False"
                 ItemContainerStyle="{StaticResource UnitItem}" SelectionChanged="UnitList_SelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type local:UnitEntry}">
              <Grid x:Name="row">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <local:ThumbView Width="44" Height="44" Kind="Square" Source="{Binding ListImage}"
                                 Zoom="{Binding Zoom}" XFrac="{Binding X}" YFrac="{Binding Y}"/>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Id, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding TeamLabel, Mode=OneWay}"/>
                  </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock x:Name="nosave" Text="default" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,6,0"
                             ToolTip="No saved thumbnail yet (showing the default framing)" Visibility="Collapsed"/>
                  <TextBlock x:Name="state" Text="{Binding StateLabel}" FontSize="10" Foreground="{StaticResource Muted}"
                             VerticalAlignment="Center" ToolTip="editing → saved (classes.json) → committed → pushed → deploying"/>
                </StackPanel>
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Editing">
                  <Setter TargetName="state" Property="Foreground" Value="{StaticResource Accent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Saved">
                  <Setter TargetName="state" Property="Foreground" Value="#C9CBD6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Committed">
                  <Setter TargetName="state" Property="Foreground" Value="#7FB2F0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Pushed">
                  <Setter TargetName="state" Property="Foreground" Value="#6CCB8A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="DeployStarted">
                  <Setter TargetName="state" Property="Foreground" Value="#6CCB8A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasSavedThumb}" Value="False">
                  <Setter TargetName="nosave" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasPortrait}" Value="False">
                  <Setter TargetName="row" Property="Opacity" Value="0.35"/>
                  <Setter TargetName="row" Property="ToolTip" Value="Portrait png is missing"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Editor -->
    <DockPanel Grid.Column="1">
      <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1" Padding="16,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="UnitName" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock x:Name="UnitState" FontSize="12" Margin="12,6,0,0" Foreground="{StaticResource Muted}"/>
            </StackPanel>
            <TextBlock x:Name="UnitSub" Foreground="{StaticResource Muted}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Zoom" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="ZoomBox" Width="70" Margin="0,0,14,0"/>
            <TextBlock Text="X" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="XBox" Width="70" Margin="0,0,14,0"/>
            <TextBlock Text="Y" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="YBox" Width="70" Margin="0,0,18,0"/>
            <Button Content="◀ Prev" Click="Prev_Click" ToolTip="Previous unit (PgUp)"/>
            <Button Content="Next ▶" Click="Next_Click" ToolTip="Next unit (PgDn)"/>
            <Button x:Name="ResetButton" Content="Revert" Click="Reset_Click" ToolTip="Back to the framing this unit had when the studio opened (it autosaves)"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0" Padding="16,7">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Foreground="{StaticResource Muted}" FontSize="12"
                     TextTrimming="CharacterEllipsis" x:Name="HintText"
                     Text="Wheel zoom (Ctrl fine) · Drag move · Arrows nudge (Shift ×10) · +/− zoom · PgUp/PgDn unit · edits autosave (Ctrl+S now)"/>
          <Border HorizontalAlignment="Right" Background="{StaticResource Panel}" Padding="12,0,0,0">
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource Accent}"/>
          </Border>
          <TextBlock Grid.Row="1" x:Name="SyncText" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                     Foreground="#C9CBD6" Text="Edits save themselves and go into the game on their own."/>
        </Grid>
      </Border>
      <local:EditorSurface x:Name="Editor"/>
    </DockPanel>

    <!-- Previews -->
    <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1,0,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18,16">
          <TextBlock Text="BOARD TOKEN" Style="{StaticResource Caption}"/>
          <local:ThumbView x:Name="TokenPreview" Kind="Token" Width="180" Height="180" HorizontalAlignment="Left" Margin="0,0,0,22"/>

          <TextBlock Text="TIMELINE ICON" Style="{StaticResource Caption}"/>
          <Border Background="#0B0C12" CornerRadius="6" Padding="12" HorizontalAlignment="Left" Margin="0,0,0,22">
            <Grid>
              <Rectangle Height="4" Fill="#2A2C3A" VerticalAlignment="Center" RadiusX="2" RadiusY="2"/>
              <StackPanel Orientation="Horizontal">
                <local:ThumbView x:Name="TimelinePreview" Kind="Timeline" Width="88" Height="88"/>
                <local:ThumbView x:Name="TimelineSmall" Kind="Timeline" Width="56" Height="56" Margin="18,0,0,0" VerticalAlignment="Center"
                                 ToolTip="Same icon at a smaller size"/>
              </StackPanel>
            </Grid>
          </Border>

          <TextBlock Text="MENU CARD" Style="{StaticResource Caption}"/>
          <Border Background="#20222C" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="6" Padding="10" HorizontalAlignment="Left">
            <StackPanel>
              <local:ThumbView x:Name="CardPreview" Kind="Square" Width="150" Height="150"/>
              <TextBlock x:Name="CardName" FontWeight="SemiBold" Margin="0,8,0,0"/>
              <TextBlock x:Name="CardTeam" Foreground="{StaticResource Muted}" FontSize="11"/>
            </StackPanel>
          </Border>

          <TextBlock Text="SAVED" Style="{StaticResource Caption}" Margin="0,22,0,6"/>
          <TextBlock x:Name="SavedText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Closing: save, commit, push, then hand the redeploy to tools\run.ps1 (GG-T223) -->
    <Border x:Name="Finishing" Grid.ColumnSpan="3" Background="#D0101116" Visibility="Collapsed">
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="8"
              Padding="28,22" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="460" MaxWidth="720">
        <StackPanel>
          <TextBlock Text="Finishing up" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <TextBlock x:Name="FinishingText" TextWrapping="Wrap" Foreground="#C9CBD6" LineHeight="20"/>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
