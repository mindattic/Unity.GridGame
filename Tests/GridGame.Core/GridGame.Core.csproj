<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the engine-free Unity source (Core + Meta) as a plain .NET Standard 2.1 library,
       matching Unity 6's API surface and C# 9, so rules are testable in seconds without the editor. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>GridGame.Core</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Gaiden/Core/**/*.cs" />
    <Compile Include="../../Assets/Gaiden/Meta/**/*.cs" />
    <!-- The shared com.mindattic.unity.shared package's engine-free core (profiles, settings.json), the same
         source Packages/manifest.json references; Meta's player profiles build on it (GG-T99). -->
    <Compile Include="../../../Unity.Shared/unity/com.mindattic.unity.shared/Runtime/Core/**/*.cs" LinkBase="Unity.Shared.Core" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
