/* GridGame Gaiden — UI theme. Final Fantasy-style menus: blue gradient windows, white rounded frames,
   pointing-hand cursor rows, gold numbers. Every screen is built in C# from these classes. */

/* -- Design tokens (GG-T250, docs/POLISH.md): the one source for color, type and spacing; App/UI/Tokens.cs
   mirrors the same values for code. Use var(--...) in rules, never a fresh literal. -- */
:root {
    --color-text: rgb(240, 242, 255);
    --color-dim: rgb(150, 160, 205);
    --color-white: rgb(255, 255, 255);
    --color-ink: rgb(15, 18, 43);
    --color-frame: rgb(236, 238, 255);
    --color-gold: rgb(255, 217, 89);
    --color-good: rgb(115, 242, 148);
    --color-bad: rgb(255, 97, 87);
    --color-warn: rgb(255, 196, 92);
    --color-info: rgb(219, 224, 255);
    --color-mana: rgb(107, 199, 255);
    --color-hero: rgb(120, 171, 255);
    --color-enemy: rgb(235, 69, 74);
    --color-boss: rgb(219, 102, 255);
    --color-guest: rgb(110, 240, 160);
    --color-neutral: rgb(255, 204, 94);
    --color-haste: rgb(89, 255, 224);
    --color-cast-hero: rgb(38, 196, 230);
    --color-cast-enemy: rgb(255, 140, 26);
    --color-el-physical: rgb(217, 224, 242);
    --color-el-fire: rgb(255, 115, 38);
    --color-el-ice: rgb(128, 217, 255);
    --color-el-lightning: rgb(255, 242, 89);
    --color-el-poison: rgb(153, 255, 77);
    --color-el-holy: rgb(255, 247, 199);
    --color-el-dark: rgb(158, 77, 242);
    --color-el-arcane: rgb(255, 115, 217);
    --color-rarity-junk: rgb(140, 140, 140);
    --color-rarity-common: rgb(236, 236, 240);
    --color-rarity-uncommon: rgb(110, 230, 120);
    --color-rarity-rare: rgb(100, 170, 255);
    --color-rarity-epic: rgb(200, 120, 255);
    --color-rarity-legendary: rgb(255, 200, 70);
    --color-gauge-full: rgb(110, 230, 120);
    --color-gauge-mid: rgb(240, 200, 70);
    --color-gauge-low: rgb(240, 80, 70);
    --type-badge: 24px;
    --type-caption: 30px;
    --type-small: 36px;
    --type-body: 40px;
    --type-h3: 48px;
    --type-h2: 60px;
    --type-h1: 76px;
    --type-display: 96px;
    --type-title: 120px;
    --space-4: 4px;
    --space-8: 8px;
    --space-12: 12px; /* half of the 24-px target gap: two neighbours' margins add up to POL-C3 */
    --size-target: 132px; /* POL-C2 minimum tap target (44 pt) */
    --space-16: 16px;
    --space-24: 24px;
    --space-32: 32px;
    --space-48: 48px;
    --space-64: 64px;
    --space-96: 96px;
}

/* Semantic type classes (POL-A1); weight comes from the Heavy font role, applied in Ui.AddClasses. */
.t-caption { font-size: var(--type-caption); }
.t-body { font-size: var(--type-body); }
.t-h3 { font-size: var(--type-h3); }
.t-h2 { font-size: var(--type-h2); }
.t-h1 { font-size: var(--type-h1); }
.t-display { font-size: var(--type-display); }

.stage {
    position: absolute;
    width: 1170px;
    height: 2532px;
    overflow: hidden;
    background-color: rgb(8, 10, 22);
    color: var(--color-text);
    font-size: var(--type-body);
}

.letterbox { background-color: rgb(4, 5, 12); }
/* Outline around the stage when the device is wider/taller than any supported phone (tablets): the bars read
   as a deliberate bezel around one big game window, in the same white rounded frame every window uses. */
.stage-frame {
    position: absolute;
    border-width: 5px;
    border-color: var(--color-frame);
    border-radius: 22px;
    background-color: rgb(0, 0, 0);
}

.fill { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.row { flex-direction: row; align-items: center; }
.col { flex-direction: column; }
.grow { flex-grow: 1; }
.center { align-items: center; justify-content: center; }
.hidden { display: none; }

/* ── Windows ─────────────────────────────────────────────────────────────── */
.window {
    border-width: 5px;
    border-color: var(--color-frame);
    border-radius: 18px;
    padding: var(--space-24) var(--space-32);
    margin: var(--space-8);
    background-size: 100% 100%;
    flex-shrink: 0;
}
/* A window holding a scrolling list (Ui.List): fills the space left over and scrolls instead of squashing the
   tabs and footers around it when its content runs long. */
.window--scroller { flex-shrink: 1; flex-basis: 0; min-height: 160px; }
.window--plain { background-color: rgba(10, 16, 52, 0.94); }
.window-title {
    font-size: var(--type-h3);
    color: var(--color-white);
    margin-bottom: var(--space-16);
}
.window-sub { font-size: var(--type-small); color: rgb(170, 184, 255); }

/* ── Text ────────────────────────────────────────────────────────────────── */
.title { font-size: var(--type-title); color: rgb(255, 244, 214); -unity-text-align: middle-center; }
.h1 { font-size: var(--type-h2); color: var(--color-white); }
.h2 { font-size: var(--type-h3); color: var(--color-white); }
.small { font-size: var(--type-caption); }
.tiny { font-size: var(--type-badge); }
.dim { color: var(--color-dim); }
.gold { color: var(--color-gold); }
.good { color: var(--color-good); }
.bad { color: var(--color-bad); }
.warn { color: var(--color-warn); }
.shadow { text-shadow: 3px 3px 0 rgba(0, 0, 0, 0.75); }
.num { -unity-text-align: middle-right; }

/* ── Menu rows (cursor hand) ─────────────────────────────────────────────── */
.menu-row {
    flex-direction: row;
    align-items: center;
    min-height: var(--size-target);
    padding: var(--space-8) var(--space-16) var(--space-8) var(--space-8);
    border-radius: 10px;
    margin: var(--space-12) 0;
}
.menu-row:hover { background-color: rgba(255, 255, 255, 0.06); }
.menu-row--selected { background-color: rgba(140, 170, 255, 0.20); }
.menu-row--disabled { opacity: 0.42; }
.menu-cursor { width: 56px; height: 56px; margin-right: var(--space-8); opacity: 0; background-size: contain; flex-shrink: 0; }
.menu-row--selected > .menu-cursor { opacity: 1; }
.menu-label { flex-grow: 1; font-size: var(--type-body); flex-shrink: 1; min-width: 0; white-space: normal; }
/* A long value (a locked station's "Opens after …" hint) wraps rather than clipping or squeezing the label. */
.menu-value { font-size: var(--type-body); -unity-text-align: middle-right; margin-left: var(--space-16); flex-shrink: 1; white-space: normal; }
.menu-icon { width: 64px; height: 64px; margin-right: var(--space-16); background-size: contain; }

/* ── Buttons ─────────────────────────────────────────────────────────────── */
/* Every button stands on a darker lip (the thick bottom border). Pressing sinks it onto the lip. */
.btn {
    min-height: var(--size-target);
    min-width: var(--size-target);
    padding: 0 var(--space-48);
    margin: var(--space-12);
    border-width: 4px;
    border-bottom-width: 12px;
    border-radius: 16px;
    border-color: var(--color-frame);
    border-bottom-color: rgb(120, 132, 196);
    background-color: rgb(34, 58, 150);
    color: var(--color-white);
    font-size: var(--type-body);
    -unity-text-align: middle-center;
}
.btn:hover { background-color: rgb(52, 84, 196); }
.btn--primary { background-color: rgb(196, 120, 24); border-color: rgb(255, 232, 170); border-bottom-color: rgb(150, 92, 30); }
.btn--primary:hover { background-color: rgb(226, 146, 40); }
.btn--danger { background-color: rgb(150, 30, 40); border-bottom-color: rgb(96, 18, 26); }
.btn--danger:hover { background-color: rgb(178, 40, 52); }

.role-badge {
    border-width: 3px;
    border-radius: 10px;
    padding: 0 var(--space-8);
    margin: 0 var(--space-8);
    background-color: rgba(4, 6, 20, 0.75);
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

/* ── Shared press feel (Ui.Pressable): sink on touch, spring back on release ── */
.pressable {
    transition-property: scale, translate, background-color, border-bottom-width, opacity;
    transition-duration: 0.06s, 0.06s, 0.08s, 0.06s, 0.1s;
    transition-timing-function: ease-out;
}
.pressable.is-pressed { scale: 0.95 0.95; translate: 0 6px; }
.pressable.is-released { transition-duration: 0.14s; transition-timing-function: ease-out-back; }
.btn.is-pressed { border-bottom-width: 4px; translate: 0 8px; background-color: rgb(24, 40, 108); }
.btn--primary.is-pressed { background-color: rgb(150, 88, 14); }
.btn--danger.is-pressed { background-color: rgb(110, 20, 28); }
.menu-row.is-pressed { background-color: rgba(140, 170, 255, 0.34); translate: 4px 2px; scale: 0.985 0.985; }
.tab.is-pressed { translate: 0 4px; scale: 0.94 0.94; }
.card-tap.is-pressed { scale: 0.94 0.94; translate: 0 6px; }
.slot { transition-property: scale, translate, opacity; transition-duration: 0.07s, 0.07s, 0.15s; }
.slot--targeting { scale: 1.06 1.06; }
.slot.is-pressed { scale: 0.92 0.92; translate: 0 10px; }
.btn--disabled { opacity: 0.4; }
.btn--small { min-height: var(--size-target); font-size: var(--type-small); padding: 0 24px; border-bottom-width: 9px; }
.btn--small.is-pressed { border-bottom-width: 3px; translate: 0 6px; }
.btn--icon { width: var(--size-target); padding: 0; }

/* ── Header bar ──────────────────────────────────────────────────────────── */
.header {
    flex-direction: row;
    align-items: center;
    height: 150px;
    padding: 0 var(--space-24);
    background-color: rgba(4, 8, 30, 0.85);
    border-bottom-width: 4px;
    border-color: var(--color-frame);
}
.header-title { flex-grow: 1; font-size: var(--type-h2); -unity-text-align: middle-left; margin-left: var(--space-16); }
.header-gold { font-size: var(--type-h3); color: var(--color-gold); -unity-text-align: middle-right; margin-right: var(--space-16); }

/* ── Tabs ────────────────────────────────────────────────────────────────── */
.tabs { flex-direction: row; margin: var(--space-8) var(--space-8) 0 var(--space-8); padding: 0 var(--space-12); flex-shrink: 0; } /* edge = tab margin 12 + 12 = gap 24 (POL-C8) */
.tab {
    flex-grow: 1;
    height: var(--size-target);
    margin: 0 var(--space-12);
    border-width: 4px 4px 0 4px;
    border-color: var(--color-frame);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    background-color: rgb(18, 28, 84);
    font-size: var(--type-small);
    -unity-text-align: middle-center;
    color: rgb(170, 184, 255);
}
.tab--active { background-color: rgb(40, 66, 170); color: var(--color-white); }

/* ── Gauges ──────────────────────────────────────────────────────────────── */
.gauge { height: 20px; border-radius: 10px; background-color: rgba(0, 0, 0, 0.6); border-width: 2px; border-color: rgba(255, 255, 255, 0.5); overflow: hidden; }
.gauge-fill { height: 100%; border-radius: 8px; background-color: var(--color-gauge-full); }
.gauge-fill--mid { background-color: var(--color-gauge-mid); }
.gauge-fill--low { background-color: var(--color-gauge-low); }

/* ── Toast / dialog ──────────────────────────────────────────────────────── */
.toast {
    position: absolute;
    left: 120px; right: 120px; bottom: 260px;
    padding: var(--space-24) var(--space-32);
    border-radius: 18px;
    border-width: 4px;
    border-color: var(--color-frame);
    background-color: rgba(12, 18, 60, 0.96);
    font-size: var(--type-body);
    -unity-text-align: middle-center;
    transition-property: opacity, translate;
    transition-duration: 0.18s;
}
.veil { background-color: rgba(0, 0, 0, 0.6); }

/* ── Fade overlay ────────────────────────────────────────────────────────── */
.fade { background-color: rgb(0, 0, 0); opacity: 0; transition-property: opacity; transition-duration: 0.22s; }
.fade--on { opacity: 1; }

/* ── Scroll views ────────────────────────────────────────────────────────── */
.list { flex-grow: 1; }
.list .unity-scroller--vertical { width: 18px; }
.list .unity-scroller__slider .unity-base-slider__dragger { background-color: rgba(236, 238, 255, 0.6); border-radius: 8px; }

/* ── Portrait card ───────────────────────────────────────────────────────── */
.card {
    flex-direction: row;
    align-items: center;
    padding: var(--space-16);
    margin: var(--space-8) 0;
    border-radius: 14px;
    background-color: rgba(255, 255, 255, 0.05);
}
.card--selected { background-color: rgba(140, 170, 255, 0.22); }
.thumb {
    width: 150px; height: 150px;
    border-radius: 16px;
    border-width: 4px;
    border-color: var(--color-frame);
    background-color: rgb(30, 36, 70);
    background-size: cover;
    margin-right: var(--space-24);
}

/* ── Battle unit frame — the same frame as .thumb, so battle and menus share one look ── */
.unit-frame {
    border-radius: 16px;
    border-width: 4px;
    border-color: var(--color-frame);
    overflow: hidden;
}
.unit-keyline { position: absolute; left: 0; top: 0; right: 0; bottom: 0; border-width: 4px; border-radius: 12px; }
.unit-keyline--hero { border-color: var(--color-hero); }
.unit-keyline--foe { border-color: var(--color-enemy); }
.unit-keyline--boss { border-color: var(--color-boss); }
.unit-keyline--guest { border-color: var(--color-guest); }
.unit-keyline--neutral { border-color: var(--color-neutral); }
.unit-keyline--tamed { border-color: rgb(194, 235, 71); } /* Palette.Tamed: a tamed/domesticated monster (GG-T303) */

/* ── Orb pips (generic mana) ──────────────────────────────────────────── */
.pip { width: 34px; height: 34px; border-radius: 17px; margin: 0 var(--space-4); border-width: 2px; border-color: rgba(255,255,255,0.8); font-size: var(--type-badge); -unity-text-align: middle-center; color: var(--color-ink); }
.pip--mana { background-color: var(--color-mana); }

/* ── Rarity colors ───────────────────────────────────────────────────────── */
.rarity-Junk { color: var(--color-rarity-junk); }
.rarity-Common { color: var(--color-rarity-common); }
.rarity-Uncommon { color: var(--color-rarity-uncommon); }
.rarity-Rare { color: var(--color-rarity-rare); }
.rarity-Epic { color: var(--color-rarity-epic); }
.rarity-Legendary { color: var(--color-rarity-legendary); }

/* ══ Menu themes (GG-T185) ══════════════════════════════════════════════════
   Ui.ApplyMenuTheme puts the active theme's class (Art.MenuTheme.UssClass) on the UI root, so each theme is one
   block of rules scoped under it, switched live with no rebuild. The window body is the generated gradient
   (Art.Window); these rules restyle the frame, tabs, buttons and the few fixed-color surfaces. Rules here must
   come after the base rules (equal specificity: the later one wins), and a theme that recolors .btn re-declares
   .btn--primary/.btn--danger and the :hover/.is-pressed states, which its .btn rule would otherwise outrank.
   A new theme = one row in Art.Themes + one block like this. */

/* ── Slate: Chrono Trigger's default window — gray-blue gradient, light bevel frame, white text ── */
.theme-slate .window {
    border-width: 6px;
    border-radius: 10px;
    border-top-color: rgb(236, 238, 246);
    border-left-color: rgb(214, 218, 232);
    border-right-color: rgb(128, 136, 162);
    border-bottom-color: rgb(104, 110, 136);
}
.theme-slate .window--plain { background-color: rgba(56, 62, 90, 0.94); }
.theme-slate .window-title { color: rgb(255, 255, 255); }
.theme-slate .window-sub { color: rgb(208, 214, 232); }
.theme-slate .dim { color: rgb(178, 186, 212); }
.theme-slate .menu-row--selected { background-color: rgba(255, 255, 255, 0.16); }
.theme-slate .menu-row.is-pressed { background-color: rgba(255, 255, 255, 0.26); }
.theme-slate .card--selected { background-color: rgba(255, 255, 255, 0.16); }

.theme-slate .header {
    background-color: rgba(52, 58, 86, 0.92);
    border-color: rgb(214, 218, 232);
}
.theme-slate .toast {
    background-color: rgba(64, 70, 102, 0.97);
    border-top-color: rgb(236, 238, 246);
    border-left-color: rgb(214, 218, 232);
    border-right-color: rgb(128, 136, 162);
    border-bottom-color: rgb(104, 110, 136);
}

.theme-slate .tab {
    border-radius: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-top-color: rgb(236, 238, 246);
    border-left-color: rgb(214, 218, 232);
    border-right-color: rgb(128, 136, 162);
    background-color: rgb(62, 68, 98);
    color: rgb(190, 198, 222);
}
.theme-slate .tab--active { background-color: rgb(112, 122, 154); color: rgb(255, 255, 255); }

.theme-slate .btn {
    border-radius: 10px;
    border-top-color: rgb(236, 238, 246);
    border-left-color: rgb(214, 218, 232);
    border-right-color: rgb(128, 136, 162);
    border-bottom-color: rgb(74, 80, 106);
    background-color: rgb(92, 100, 132);
    color: rgb(255, 255, 255);
}
.theme-slate .btn:hover { background-color: rgb(108, 118, 152); }
.theme-slate .btn.is-pressed { background-color: rgb(70, 76, 104); }
.theme-slate .btn--primary { background-color: rgb(196, 120, 24); border-top-color: rgb(255, 232, 170); border-left-color: rgb(255, 232, 170); border-right-color: rgb(255, 232, 170); border-bottom-color: rgb(150, 92, 30); }
.theme-slate .btn--primary:hover { background-color: rgb(226, 146, 40); }
.theme-slate .btn--primary.is-pressed { background-color: rgb(150, 88, 14); }
.theme-slate .btn--danger { background-color: rgb(150, 30, 40); border-bottom-color: rgb(96, 18, 26); }
.theme-slate .btn--danger:hover { background-color: rgb(178, 40, 52); }
.theme-slate .btn--danger.is-pressed { background-color: rgb(110, 20, 28); }

/* ── Menu theme: Dark (GG-T186) ────────────────────────────────────────────────
   The DocFX modern dark docs / mindattic.com look, on MindAttic.Components' web/themes/Dark/dark.css tokens:
   near-black surfaces (--bg #0d0f12, --bg2 #13161b, --bg3 #1a1e25), a subtle hairline border (--border #2a2f3a),
   one accent (--accent #6ba3e8, hover --accent2 #90bbf0), text #e8eaf0 / #9aa0b0. Flat windows (Art "Dark" paints
   the window texture one solid --bg2), no white bevel frames, no drop-shadowed text. Ui.ApplyMenuTheme puts
   .theme-dark on the panel root while the theme is picked; gold / good / bad / rarity stay semantic. */
.theme-dark .stage { background-color: rgb(13, 15, 18); color: rgb(232, 234, 240); }
.theme-dark .letterbox { background-color: rgb(11, 14, 20); }
.theme-dark .stage-frame { border-width: 2px; border-color: rgb(42, 47, 58); border-radius: 12px; background-color: rgb(13, 15, 18); }

.theme-dark .window { border-width: 2px; border-radius: 10px; border-color: rgb(42, 47, 58); }
.theme-dark .window--plain { background-color: rgba(19, 22, 27, 0.97); }
.theme-dark .window-title { color: rgb(232, 234, 240); }
.theme-dark .window-sub { color: rgb(154, 160, 176); }
.theme-dark .title { color: rgb(232, 234, 240); }
.theme-dark .h1, .theme-dark .h2 { color: rgb(232, 234, 240); }
.theme-dark .dim { color: rgb(154, 160, 176); }
.theme-dark .shadow { text-shadow: 0 0 0 rgba(0, 0, 0, 0); }

.theme-dark .menu-row { border-radius: 6px; }
.theme-dark .menu-row:hover { background-color: rgba(255, 255, 255, 0.04); }
.theme-dark .menu-row--selected { background-color: rgba(107, 163, 232, 0.14); }
.theme-dark .menu-row.is-pressed { background-color: rgba(107, 163, 232, 0.26); }

/* Buttons keep a thin dark lip so the shared press feel still has something to sink onto. */
.theme-dark .btn {
    border-width: 2px;
    border-bottom-width: 7px;
    border-radius: 8px;
    border-color: rgb(42, 47, 58);
    border-bottom-color: rgb(8, 10, 13);
    background-color: rgb(26, 30, 37);
    color: rgb(232, 234, 240);
}
.theme-dark .btn:hover { background-color: rgb(34, 39, 48); border-color: rgb(61, 111, 163); border-bottom-color: rgb(8, 10, 13); }
.theme-dark .btn--primary { background-color: rgb(107, 163, 232); border-color: rgb(107, 163, 232); border-bottom-color: rgb(61, 111, 163); color: rgb(13, 15, 18); }
.theme-dark .btn--primary:hover { background-color: rgb(144, 187, 240); border-color: rgb(144, 187, 240); border-bottom-color: rgb(61, 111, 163); }
.theme-dark .btn--danger { background-color: rgb(58, 24, 30); border-color: rgb(110, 42, 52); border-bottom-color: rgb(30, 10, 14); color: rgb(255, 160, 160); }
.theme-dark .btn--danger:hover { background-color: rgb(78, 30, 38); border-color: rgb(140, 52, 64); border-bottom-color: rgb(30, 10, 14); }
.theme-dark .btn.is-pressed { border-bottom-width: 2px; translate: 0 5px; background-color: rgb(19, 22, 27); }
.theme-dark .btn--primary.is-pressed { background-color: rgb(84, 140, 210); }
.theme-dark .btn--danger.is-pressed { background-color: rgb(44, 18, 22); }
.theme-dark .btn--small { border-bottom-width: 5px; }
.theme-dark .btn--small.is-pressed { border-bottom-width: 2px; translate: 0 3px; }

.theme-dark .role-badge { background-color: rgb(13, 15, 18); border-width: 2px; border-radius: 6px; }

.theme-dark .header { background-color: rgba(13, 15, 18, 0.94); border-bottom-width: 2px; border-color: rgb(42, 47, 58); }
.theme-dark .header-title { color: rgb(232, 234, 240); }

.theme-dark .tab {
    border-width: 2px 2px 0 2px;
    border-color: rgb(42, 47, 58);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    background-color: rgb(19, 22, 27);
    color: rgb(154, 160, 176);
}
.theme-dark .tab--active { background-color: rgb(26, 30, 37); color: rgb(232, 234, 240); border-top-color: rgb(107, 163, 232); border-top-width: 4px; }

.theme-dark .gauge { background-color: rgb(13, 15, 18); border-color: rgb(42, 47, 58); }

.theme-dark .toast { background-color: rgba(19, 22, 27, 0.97); border-width: 2px; border-radius: 10px; border-color: rgb(42, 47, 58); color: rgb(232, 234, 240); }
.theme-dark .veil { background-color: rgba(5, 6, 8, 0.72); }

.theme-dark .list .unity-scroller__slider .unity-base-slider__dragger { background-color: rgba(154, 160, 176, 0.45); border-radius: 6px; }

.theme-dark .card { background-color: rgba(255, 255, 255, 0.03); border-radius: 8px; }
.theme-dark .card--selected { background-color: rgba(107, 163, 232, 0.14); }
.theme-dark .thumb { border-width: 2px; border-radius: 8px; border-color: rgb(42, 47, 58); background-color: rgb(26, 30, 37); }

/* ── Quest journal hand-in card (GG-T237): slides in rather than popping ── */
.quest-turnin { transition-property: opacity, translate; transition-duration: 0.35s; transition-timing-function: ease-out-back; }
.quest-turnin.is-hidden { opacity: 0; translate: 0 -40px; }
